# Placeholders only. Never copy .env.local or production credentials.
# Local harness: NODE_ENV=test, STAGING_ENVIRONMENT=staging, BOLA_ENV_FILES=false.
# Backend deployment uses its own production-mode configuration, not this harness file.
NODE_ENV=
BOLA_ENV_FILES=
STAGING_ENVIRONMENT=
STAGING_ALLOW_WRITES=
STAGING_ISOLATION_FILE=
STAGING_FRONTEND_ORIGIN=
STAGING_BACKEND_URL=
STAGING_REPLICA_COUNT=
STAGING_GEMINI_PROJECT_ID=
STAGING_AI_BUDGET_CONFIRMED=
# Runtime and administrative test identities must differ; explicit JSON only in the harness.
FIREBASE_SERVICE_ACCOUNT_JSON=
STAGING_FIREBASE_ADMIN_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_USE_APPLICATION_DEFAULT=
# Frontend public configuration; never put admin/provider secrets into VITE_*.
VITE_SERVER_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Redis normal application vs explicit real-Redis tests. Dedicated staging only.
REDIS_URL=
TEST_REDIS_URL=
# Backend, CORS and proxy: fill only after the real proxy chain is documented.
PORT=
CLIENT_ORIGIN=
TRUST_PROXY=
ENABLE_HSTS=
# Optional HTTPS-only ingress assertion; exact origin, Railway backend-staging/staging only.
# With ENABLE_HSTS=true, uses max-age=86400 without subdomains/preload. Does not trust XFP.
STAGING_HTTPS_ORIGIN=
# Temporary opt-in logger (default disabled), max 48 tagged requests/replica, expiry <= 1 hour.
STAGING_PROXY_DIAGNOSTICS=
STAGING_PROXY_DIAGNOSTICS_RUN_ID=
STAGING_PROXY_DIAGNOSTICS_UNTIL=
ROOM_STORE=
ALLOW_DEMO_AUTH=
ALLOW_LOCAL_EDITOR=
EDITOR_ADMIN_UIDS=
MATCH_EVENT_DELAY_MS=
INSTANCE_ID=
LOCK_TTL_MS=
LOCK_WAIT_MS=
LOCK_RETRY_MS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_HTTP_MAX=
RATE_LIMIT_SOCKET_MAX=
METRICS_TOKEN=
DEPENDENCY_TIMEOUT_MS=
READINESS_CACHE_MS=
AUTH_TIMEOUT_MS=
SOCKET_AUTH_RECHECK_MS=
HTTP_SLOW_MS=
SOCKET_SLOW_MS=
EVENT_LOOP_WARN_MS=
MATCH_PERSISTENCE_TIMEOUT_MS=
SHUTDOWN_TIMEOUT_MS=
IMPORT_OBJECT_TTL_DAYS=
IMPORT_MAX_SESSIONS_PER_UID=
IMPORT_MAX_RESERVED_BYTES_PER_UID=
IMPORT_MAX_PROCESSES_PER_UID=
AI_BUDGET_WINDOW_MS=
AI_OPERATION_ATTEMPTS=
AI_UID_ATTEMPTS=
AI_GLOBAL_ATTEMPTS=
AI_UID_CONCURRENCY=
AI_GLOBAL_CONCURRENCY=
