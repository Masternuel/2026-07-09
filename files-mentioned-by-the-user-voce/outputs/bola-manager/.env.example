# Frontend (Firebase Client — opcional; o modo demonstração funciona sem credenciais)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Opcional no frontend: uploads do Editor passam sempre pelo backend.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SERVER_URL=http://localhost:3001

# Backend (Firebase Admin — nunca use estas variáveis no frontend)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
NODE_ENV=development
MATCH_EVENT_DELAY_MS=800
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_USE_APPLICATION_DEFAULT=false
ALLOW_DEMO_AUTH=false
ROOM_STORE=firestore

# Coordenacao multi-replica (Railway Redis/Valkey compartilhado)
REDIS_URL=
INSTANCE_ID=
LOCK_TTL_MS=15000
LOCK_WAIT_MS=2000
LOCK_RETRY_MS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_HTTP_MAX=240
RATE_LIMIT_SOCKET_MAX=120
# Coleta privada: vazio desativa /metrics. Use segredo aleatorio de pelo menos 32 caracteres.
# Apenas backend/coletor, via Authorization: Bearer. Nunca use VITE_ ou query string.
METRICS_TOKEN=
DEPENDENCY_TIMEOUT_MS=2500
AUTH_TIMEOUT_MS=10000
SOCKET_AUTH_RECHECK_MS=60000
HTTP_SLOW_MS=5000
SOCKET_SLOW_MS=5000
EVENT_LOOP_WARN_MS=250
MATCH_PERSISTENCE_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
IMPORT_OBJECT_TTL_DAYS=1

# Imagens do Editor. Cloudinary evita a exigencia de plano do Firebase Storage.
# No Railway, use MEDIA_STORAGE_PROVIDER=cloudinary e configure somente CLOUDINARY_URL
# ou somente o trio CLOUDINARY_CLOUD_NAME/API_KEY/API_SECRET.
MEDIA_STORAGE_PROVIDER=auto
CLOUDINARY_URL=
# Alternativa ao CLOUDINARY_URL: configure as tres variaveis abaixo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# UIDs do Firebase Auth autorizados a editar a base, separados por virgula.
EDITOR_ADMIN_UIDS=
# Somente desenvolvimento local: libera qualquer usuario Firebase autenticado quando a lista acima esta vazia.
ALLOW_LOCAL_EDITOR=false

# Backend (Gemini — nunca use VITE_ nem exponha esta chave no navegador)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
