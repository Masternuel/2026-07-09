# Frontend (Firebase Client — opcional; o modo demonstração funciona sem credenciais)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Opcional: o Bola Manager atual não inicializa o Firebase Storage.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SERVER_URL=http://localhost:3001

# Backend (Firebase Admin — nunca use estas variáveis no frontend)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
NODE_ENV=development
MATCH_EVENT_DELAY_MS=800
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_USE_APPLICATION_DEFAULT=false
ALLOW_DEMO_AUTH=false
ROOM_STORE=firestore
# UIDs do Firebase Auth autorizados a editar a base, separados por virgula.
EDITOR_ADMIN_UIDS=
# Somente desenvolvimento local: libera qualquer usuario Firebase autenticado quando a lista acima esta vazia.
ALLOW_LOCAL_EDITOR=false

# Backend (Gemini — nunca use VITE_ nem exponha esta chave no navegador)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
