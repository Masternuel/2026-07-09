{
  "name": "bola-manager",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Bola Manager — carreira local e multiplayer P2P",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -n WEB,SERVER -c green,cyan \"npm:dev:client\" \"npm:server:dev\"",
    "dev:client": "vite --configLoader runner",
    "desktop": "npm run build:desktop && electron desktop/main.mjs",
    "build:desktop": "npm run typecheck && node scripts/build-desktop.mjs",
    "installer:windows": "npm run build:desktop && node scripts/package-desktop.mjs",
    "portable:windows": "npm run build:desktop && node scripts/package-desktop.mjs --dir",
    "pretest:desktop": "npm run build:desktop",
    "test:desktop": "node --test --test-concurrency=1 desktop/tests/*.test.mjs",
    "server": "node server/index.mjs",
    "server:dev": "node --watch server/index.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "prebuild": "npm run check:encoding",
    "typecheck": "tsc -b --pretty false",
    "pretypecheck": "npm run check:encoding",
    "check:encoding": "node scripts/check-encoding.mjs",
    "preview": "vite preview",
    "test:server": "node --test --test-concurrency=1 server/tests/*.test.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "security:staging:preflight": "node scripts/security-staging-preflight.mjs",
    "security:staging:redis": "node scripts/security-staging-runner.mjs redis",
    "security:staging:firebase": "node scripts/security-staging-runner.mjs firebase",
    "security:staging:media": "node scripts/security-staging-runner.mjs media",
    "security:staging:ai": "node scripts/security-staging-runner.mjs ai",
    "security:staging:cleanup": "node scripts/security-staging-runner.mjs cleanup",
    "import:brasfoot": "node scripts/import-brasfoot.mjs --dry-run --input ./data/brasfoot-normalized.json",
    "seed:builtin": "node scripts/seed-builtin-catalog.mjs --dry-run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "electron": "44.10.2",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "overrides": {
    "express": {
      "qs": "6.17.1"
    },
    "firebase-admin": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
