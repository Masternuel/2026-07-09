# Normalize text to LF in the repo and on checkout (the index is already LF).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never diff or convert.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.dat   binary
*.ban   binary
*.bolasave binary
